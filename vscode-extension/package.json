{
  "name": "tutorbot",
  "displayName": "TutorBot",
  "icon": "images/icon.png",
  "description": "TutorBot in VS Code: a Claude Code–style chat panel with typeset math, interactive quizzes, coding exercises checked as you type, and a progress dashboard.",
  "repository": {
    "type": "git",
    "url": "https://github.com/carltonking/tutorbot-vscode.git",
    "directory": "vscode-extension"
  },
  "version": "0.12.8",
  "publisher": "CarltonKing",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Education"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:tutorbot.chat"
  ],
  "contributes": {
    "commands": [
      {
        "command": "tutorbot.focus",
        "title": "Open Chat",
        "category": "TutorBot",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "tutorbot.dashboard",
        "title": "Open Progress",
        "category": "TutorBot",
        "icon": "$(graph)"
      },
      {
        "command": "tutorbot.home",
        "title": "Home (Switch Subject)",
        "category": "TutorBot",
        "icon": "$(home)"
      },
      {
        "command": "tutorbot.newChat",
        "title": "New Chat",
        "category": "TutorBot",
        "icon": "$(add)"
      },
      {
        "command": "tutorbot.conversations",
        "title": "Conversations",
        "category": "TutorBot"
      },
      {
        "command": "tutorbot.chooseModel",
        "title": "Change Model",
        "category": "TutorBot"
      },
      {
        "command": "tutorbot.connectApiKey",
        "title": "Connect API Key",
        "category": "TutorBot",
        "icon": "$(key)"
      },
      {
        "command": "tutorbot.removeApiKey",
        "title": "Remove API Key",
        "category": "TutorBot"
      },
      {
        "command": "tutorbot.restart",
        "title": "Restart TutorBot",
        "category": "TutorBot",
        "icon": "$(debug-restart)"
      },
      {
        "command": "tutorbot.showLog",
        "title": "Show Log",
        "category": "TutorBot"
      },
      {
        "command": "tutorbot.toggleWorking",
        "title": "Toggle Clean Mode (Hide Thinking & Tool Steps)",
        "category": "TutorBot",
        "icon": "$(eye-closed)"
      },
      {
        "command": "tutorbot.submit",
        "title": "Submit Exercise",
        "category": "TutorBot",
        "icon": "$(pass)"
      },
      {
        "command": "tutorbot.hint",
        "title": "Get a Hint",
        "category": "TutorBot",
        "icon": "$(lightbulb)"
      },
      {
        "command": "tutorbot.ask",
        "title": "Ask TutorBot About This Code",
        "category": "TutorBot"
      },
      {
        "command": "tutorbot.checkFile",
        "title": "Check This File",
        "category": "TutorBot",
        "icon": "$(beaker)"
      },
      {
        "command": "tutorbot.openExercise",
        "title": "Open Current Exercise",
        "category": "TutorBot"
      },
      {
        "command": "tutorbot.openSubject",
        "title": "Open Subject",
        "category": "TutorBot",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "tutorbot.newSubject",
        "title": "New Subject",
        "category": "TutorBot",
        "icon": "$(add)"
      },
      {
        "command": "tutorbot.renameSubject",
        "title": "Rename Subject",
        "category": "TutorBot",
        "icon": "$(edit)"
      },
      {
        "command": "tutorbot.removeSubject",
        "title": "Remove Subject",
        "category": "TutorBot",
        "icon": "$(trash)"
      },
      {
        "command": "tutorbot.addSubjectFolder",
        "title": "Add Class Folder",
        "category": "TutorBot",
        "icon": "$(new-folder)"
      },
      {
        "command": "tutorbot.removeSubjectFolder",
        "title": "Remove Class Folder",
        "category": "TutorBot",
        "icon": "$(close)"
      },
      {
        "command": "tutorbot.refreshSubjects",
        "title": "Refresh Subjects",
        "category": "TutorBot",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "tutorbot.newSubject",
          "when": "view == tutorbot.directory",
          "group": "navigation@1"
        },
        {
          "command": "tutorbot.focus",
          "when": "view == tutorbot.directory",
          "group": "navigation@2"
        },
        {
          "command": "tutorbot.dashboard",
          "when": "view == tutorbot.directory",
          "group": "navigation@3"
        },
        {
          "command": "tutorbot.newChat",
          "when": "view == tutorbot.directory",
          "group": "more@0"
        },
        {
          "command": "tutorbot.conversations",
          "when": "view == tutorbot.directory",
          "group": "more@0"
        },
        {
          "command": "tutorbot.refreshSubjects",
          "when": "view == tutorbot.directory",
          "group": "more@0"
        },
        {
          "command": "tutorbot.chooseModel",
          "when": "view == tutorbot.directory",
          "group": "more@1"
        },
        {
          "command": "tutorbot.connectApiKey",
          "when": "view == tutorbot.directory",
          "group": "more@1"
        },
        {
          "command": "tutorbot.restart",
          "when": "view == tutorbot.directory",
          "group": "more@2"
        },
        {
          "command": "tutorbot.showLog",
          "when": "view == tutorbot.directory",
          "group": "more@3"
        }
      ],
      "editor/title": [
        {
          "command": "tutorbot.submit",
          "when": "tutorbot.isExerciseFile",
          "group": "navigation@1"
        },
        {
          "command": "tutorbot.hint",
          "when": "tutorbot.isExerciseFile",
          "group": "navigation@2"
        },
        {
          "command": "tutorbot.checkFile",
          "when": "resourceLangId =~ /^(python|java|javascript)$/ && !tutorbot.isExerciseFile",
          "group": "navigation@3"
        },
        {
          "command": "tutorbot.newChat",
          "when": "activeWebviewPanelId == tutorbot.chat",
          "group": "navigation@1"
        },
        {
          "command": "tutorbot.dashboard",
          "when": "activeWebviewPanelId == tutorbot.chat",
          "group": "navigation@2"
        },
        {
          "command": "tutorbot.conversations",
          "when": "activeWebviewPanelId == tutorbot.chat",
          "group": "1_tutorbot@1"
        },
        {
          "command": "tutorbot.chooseModel",
          "when": "activeWebviewPanelId == tutorbot.chat",
          "group": "1_tutorbot@2"
        },
        {
          "command": "tutorbot.restart",
          "when": "activeWebviewPanelId == tutorbot.chat",
          "group": "1_tutorbot@3"
        },
        {
          "command": "tutorbot.toggleWorking",
          "when": "activeWebviewPanelId == tutorbot.chat",
          "group": "1_tutorbot@4"
        }
      ],
      "editor/context": [
        {
          "command": "tutorbot.ask",
          "when": "editorTextFocus",
          "group": "tutorbot@1"
        },
        {
          "command": "tutorbot.checkFile",
          "when": "resourceLangId =~ /^(python|java|javascript)$/ && !tutorbot.isExerciseFile",
          "group": "tutorbot@2"
        }
      ],
      "commandPalette": [
        {
          "command": "tutorbot.submit",
          "when": "tutorbot.hasExercise"
        },
        {
          "command": "tutorbot.hint",
          "when": "tutorbot.hasExercise"
        },
        {
          "command": "tutorbot.openExercise",
          "when": "tutorbot.hasExercise"
        },
        {
          "command": "tutorbot.checkFile",
          "when": "editorLangId =~ /^(python|java|javascript)$/"
        },
        {
          "command": "tutorbot.removeSubjectFolder",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "tutorbot.checkFile",
          "when": "resourceLangId =~ /^(python|java|javascript)$/",
          "group": "tutorbot@1"
        }
      ],
      "view/item/context": [
        {
          "command": "tutorbot.renameSubject",
          "when": "view == tutorbot.directory && viewItem == subject",
          "group": "inline@1"
        },
        {
          "command": "tutorbot.removeSubject",
          "when": "view == tutorbot.directory && viewItem == subject",
          "group": "inline@2"
        },
        {
          "command": "tutorbot.openSubject",
          "when": "view == tutorbot.directory && viewItem == subject",
          "group": "1_open@1"
        },
        {
          "command": "tutorbot.renameSubject",
          "when": "view == tutorbot.directory && viewItem == subject",
          "group": "2_edit@1"
        },
        {
          "command": "tutorbot.addSubjectFolder",
          "when": "view == tutorbot.directory && viewItem == subject",
          "group": "2_edit@2"
        },
        {
          "command": "tutorbot.removeSubject",
          "when": "view == tutorbot.directory && viewItem == subject",
          "group": "3_remove@1"
        },
        {
          "command": "tutorbot.removeSubjectFolder",
          "when": "view == tutorbot.directory && viewItem == folder",
          "group": "inline@1"
        },
        {
          "command": "tutorbot.removeSubjectFolder",
          "when": "view == tutorbot.directory && viewItem == folder",
          "group": "1_edit@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "tutorbot.focus",
        "key": "ctrl+escape",
        "mac": "cmd+escape"
      },
      {
        "command": "tutorbot.ask",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k",
        "when": "editorTextFocus"
      },
      {
        "command": "tutorbot.submit",
        "key": "ctrl+alt+enter",
        "mac": "cmd+alt+enter",
        "when": "tutorbot.isExerciseFile"
      },
      {
        "command": "tutorbot.hint",
        "key": "ctrl+alt+h",
        "mac": "cmd+alt+h",
        "when": "tutorbot.isExerciseFile"
      }
    ],
    "configuration": {
      "title": "TutorBot",
      "properties": {
        "tutorbot.hideWorking": {
          "type": "boolean",
          "default": true,
          "description": "Hide TutorBot's thinking and the tool steps it runs, so the chat shows only its replies, quizzes and exercises."
        },
        "tutorbot.home": {
          "type": "string",
          "default": "",
          "description": "Folder TutorBot keeps your notes, progress and exercises in. Empty = ~/TutorBot."
        },
        "tutorbot.liveCheckDelayMs": {
          "type": "number",
          "default": 800,
          "minimum": 200,
          "description": "Pause in typing (ms) before exercise tests re-run on your unsaved code."
        },
        "tutorbot.model": {
          "type": "string",
          "default": "",
          "description": "Model as provider/id (e.g. anthropic/claude-sonnet-5-5). Empty = automatic: TutorBot picks one from the providers you've connected with TutorBot: Connect API Key."
        },
        "tutorbot.nodePath": {
          "type": "string",
          "default": "",
          "description": "Advanced: Node.js to run TutorBot with. Empty = VS Code's built-in Node.js."
        },
        "tutorbot.piPath": {
          "type": "string",
          "default": "",
          "description": "Advanced: path to a pi CLI (cli.js) to use instead of the one bundled with the extension."
        },
        "tutorbot.tutorPath": {
          "type": "string",
          "default": "",
          "description": "Development: folder with TutorBot's extensions/ and skills/ to load instead of the bundled copy. Empty = bundled."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tutorbot",
          "title": "TutorBot",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "tutorbot": [
        {
          "id": "tutorbot.directory",
          "name": "Subjects",
          "icon": "media/icon.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "tutorbot.directory",
        "contents": "No subjects yet. Add the classes you're studying, then click one to chat with TutorBot about it.\n[+ Add Class](command:tutorbot.newSubject)\n[Open Chat](command:tutorbot.focus)"
      }
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@vscode/vsce": "3.6.2",
    "playwright-core": "1.56.1",
    "ts-fsrs": "5.4.2"
  },
  "scripts": {
    "build-runtime": "node scripts/build-runtime.mjs",
    "test": "node --test test/*.test.mjs",
    "vscode:prepublish": "npm run build-runtime",
    "package": "vsce package --baseImagesUrl https://github.com/carltonking/tutorbot-vscode/raw/HEAD/vscode-extension --baseContentUrl https://github.com/carltonking/tutorbot-vscode/blob/HEAD/vscode-extension"
  },
  "keywords": [
    "tutor",
    "learning",
    "education",
    "study",
    "quiz",
    "spaced repetition",
    "AI",
    "math",
    "programming"
  ]
}
